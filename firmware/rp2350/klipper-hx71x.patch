 // hx71x ADC query
+
+#define HX71X_MAX_GROUP 8
+
+static void
+hx71x_read_adc_group(struct hx71x_adc **adcs, uint8_t *oids, int count)
+{
+    if (count <= 0)
+        return;
+    uint_fast8_t gain_channel = adcs[0]->gain_channel;
+    uint32_t raw[HX71X_MAX_GROUP];
+    if (count > HX71X_MAX_GROUP)
+        count = HX71X_MAX_GROUP;
+
+    hx71x_raw_read_group(adcs, raw, count, 24 + gain_channel);
+
+    for (int i=0; i<count; i++) {
+        struct hx71x_adc *hx71x = adcs[i];
+        uint8_t oid = oids[i];
+        uint32_t adc = raw[i];
+
+        irq_disable();
+        uint8_t flags = hx71x->flags;
+        hx71x->flags = 0;
+        irq_enable();
+
+        uint32_t counts = adc >> gain_channel;
+        if (counts & 0x800000)
+            counts |= 0xFF000000;
+
+        uint_fast8_t extras_mask = (1 << gain_channel) - 1;
+        if ((adc & extras_mask) != extras_mask) {
+            hx71x->last_error = SAMPLE_ERROR_DESYNC;
+        } else if (flags & HX_OVERFLOW) {
+            hx71x->last_error = SAMPLE_ERROR_READ_TOO_LONG;
+        }
+
+        if (hx71x->last_error != 0) {
+            counts = hx71x->last_error;
+        }
+
+        if (hx71x->last_error == 0 && hx71x->lce) {
+            load_cell_probe_report_sample(hx71x->lce, counts);
+        }
+
+        add_sample(hx71x, oid, counts, false);
+    }
+}
+
 static void
 hx71x_read_adc(struct hx71x_adc *hx71x, uint8_t oid)
 {
