+static void
+hx71x_raw_read_group(struct hx71x_adc **adcs, uint32_t *out, int count
+                     , int num_bits)
+{
+    for (int i=0; i<count; i++)
+        out[i] = 0;
+    struct gpio_out sclk = adcs[0]->sclk;
+    while (num_bits--) {
+        irq_disable();
+        gpio_out_toggle_noirq(sclk);
+        hx71x_delay_noirq();
+        gpio_out_toggle_noirq(sclk);
+        for (int i=0; i<count; i++) {
+            uint_fast8_t bit = gpio_in_read(adcs[i]->dout);
+            out[i] = (out[i] << 1) | bit;
+        }
+        irq_enable();
+        hx71x_delay();
+    }
+}
