+
+if (!sched_check_wake(&wake_hx71x))
+    return;
+
+uint8_t oid;
+struct hx71x_adc *hx71x;
+foreach_oid(oid, hx71x, command_config_hx71x) {
+    if (!hx71x->flags)
+        continue;
+
+    struct hx71x_adc *group[HX71X_MAX_GROUP];
+    uint8_t oids[HX71X_MAX_GROUP];
+    int count = 0;
+    uint8_t oid2;
+    struct hx71x_adc *hx2;
+
+    foreach_oid(oid2, hx2, command_config_hx71x) {
+        if (!hx2->rest_ticks)
+            continue;
+        if (hx2->sclk_pin != hx71x->sclk_pin)
+            continue;
+        if (hx2->gain_channel != hx71x->gain_channel)
+            continue;
+        if (!hx71x_is_data_ready(hx2))
+            continue;
+        if (count < HX71X_MAX_GROUP) {
+            group[count] = hx2;
+            oids[count] = oid2;
+            count++;
+        }
+    }
+
+    if (count <= 1) {
+        hx71x_read_adc(hx71x, oid);
+        continue;
     }
+
+    hx71x_read_adc_group(group, oids, count);
+}
 }
 DECL_TASK(hx71x_capture_task);
